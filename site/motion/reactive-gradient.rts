import { Div, State } from 'corrente';

import './reactive-gradient-styles.css';

export const ReactiveGradient = () => {
  const mouseMovementX = new State(0);
  const hue = (mouseMovementX / 4) % 360; // plain maths, but hue is live

  return Div
    .class('reactive-gradient')
    .onMousemove(e => mouseMovementX.update(x => x + e.movementX))
    .style({ background: `linear-gradient(135deg, hsl(${hue} 85% 55%), hsl(${hue + 60} 85% 60%))` })
    `Move your mouse`;
};
